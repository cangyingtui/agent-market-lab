[Unit]
Description=Agentsim API service
After=network-online.target mysql.service redis.service
Wants=network-online.target

[Service]
Type=simple
User=agentsim
Group=agentsim
WorkingDirectory=/opt/agentsim
EnvironmentFile=/opt/agentsim/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/agentsim/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
