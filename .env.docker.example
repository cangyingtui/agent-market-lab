APP_NAME=Product Market Simulation Platform
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
ENABLE_DEBUG_API=false
TZ=Asia/Shanghai

MYSQL_ROOT_PASSWORD=replace_this_mysql_root_password
MYSQL_DATABASE=simulation_db
MYSQL_USER=simulation_user
MYSQL_PASSWORD=replace_this_mysql_password
DATABASE_URL=mysql+pymysql://simulation_user:replace_this_mysql_password@mysql:3306/simulation_db
DB_POOL_PRE_PING=true
DB_ECHO=false

REDIS_PASSWORD=replace_this_redis_password
REDIS_URL=redis://:replace_this_redis_password@redis:6379/0
REDIS_TASK_QUEUE=simulation:queue
REDIS_PRO_QUEUE=simulation:queue:pro
REDIS_BASIC_QUEUE=simulation:queue:basic
REDIS_EXPORT_QUEUE=simulation:queue:exports
REDIS_PROGRESS_EXPIRE_SECONDS=7200
REDIS_HEARTBEAT_TTL_SECONDS=15
HEAVY_RESOURCE_LOCK_TTL_SECONDS=7200
PDF_EXPORT_LOCK_TTL_SECONDS=900

JWT_SECRET_KEY=replace_this_with_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

LLM_PROVIDER=deepseek
LLM_API_KEY=replace_this_with_deepseek_key
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRY=2

ENABLE_RAG=true
RAG_MODE=faiss_ann
RAG_TOP_K=5
FAISS_INDEX_PATH=knowledge_model/knowledge_base/faiss_index
FAISS_METADATA_PATH=knowledge_model/knowledge_base/faiss_metadata.pkl

EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=replace_this_with_bailian_embedding_key
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_USE_DIMENSIONS_PARAM=true

ENABLE_DATA_ENRICHMENT=false
ENRICHMENT_PROVIDER=tavily
ENRICHMENT_API_KEY=replace_this_if_enabled
ENRICHMENT_API_BASE=https://api.tavily.com/search
ENRICHMENT_CACHE_TTL_HOURS=72
ENRICHMENT_MAX_ITEMS_PER_RUN=3

ENABLE_DISTILL_CHECK=false
DISTILL_MODEL_PATH=knowledge_model/sentiment
DISTILL_API_BASE=
DISTILL_API_KEY=
DISTILL_TIMEOUT_SECONDS=10
DISTILL_BATCH_SIZE=16
DISTILL_CONSISTENCY_PATH=/v1/consistency-check
DISTILL_MODEL_VERSION=sentiment_student_v2_balanced600
STUDENT_BASE_MODEL=bert-base-chinese
DISTILL_MODEL_DIR=knowledge_model/sentiment

# Social propagation uses a small-world representative network. Page sample size is
# extrapolated to the market while the actual network stays within 60-300 nodes.
SOCIAL_NETWORK_ENABLED=true
SOCIAL_NETWORK_K=4
SOCIAL_NETWORK_REWIRE_PROBABILITY=0.3
SOCIAL_NETWORK_MAX_ROUNDS=3
SOCIAL_NETWORK_CONVERGENCE_THRESHOLD=0.02
SOCIAL_TRUST_SENSITIVITY_MIN=0.5
SOCIAL_TRUST_SENSITIVITY_MAX=1.0
SOCIAL_REPRESENTATIVE_RATIO=0.03
SOCIAL_REPRESENTATIVE_MIN=60
SOCIAL_REPRESENTATIVE_MAX=300
# DeepSeek enriches only a small representative sample to limit request volume.
SOCIAL_LLM_SAMPLE_SIZE=12

TASK_TIMEOUT_SECONDS=7200
MAX_RETRY_TIMES=2
HEARTBEAT_INTERVAL_SECONDS=5
BASIC_REPORT_MIN_SECONDS=600
BASIC_REPORT_MAX_SECONDS=1800
PRO_REPORT_MIN_SECONDS=900
PRO_REPORT_MAX_SECONDS=3600
BASIC_TASK_ESTIMATE_SECONDS=1200
PRO_TASK_ESTIMATE_SECONDS=2100

SHARE_TOKEN_SALT=replace_this_with_a_different_long_random_string
EXPORT_DIR=logs/exports
PUBLIC_BASE_URL=http://your-domain-or-server-ip
FRONTEND_BASE_URL=http://your-domain-or-server-ip
FRONTEND_PORT=80
VITE_API_BASE=
PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
